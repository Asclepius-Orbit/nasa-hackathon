{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.asclepius-orbit.example/v1/catalog/cord-measurements.schema.json",
  "title": "Experimental cord resistance measurements",
  "description": "Raw observations from two different setups, not a deployable resistance-to-length calibration.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "bench": {
      "type": "object",
      "properties": {
        "contact_spacing_mm": { "type": "number", "exclusiveMinimum": 0 },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "whole_cord_length_mm": { "type": "number", "exclusiveMinimum": 0 },
              "resistance_ohm": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } }
            },
            "required": ["whole_cord_length_mm", "resistance_ohm"],
            "additionalProperties": false
          }
        }
      },
      "required": ["contact_spacing_mm", "measurements"],
      "additionalProperties": false
    },
    "back": {
      "type": "object",
      "properties": {
        "contact_spacing_mm": { "type": "number", "exclusiveMinimum": 0 },
        "straight_ohm": { "type": "number", "exclusiveMinimum": 0 },
        "max_flexion_ohm": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["contact_spacing_mm", "straight_ohm", "max_flexion_ohm"],
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "required": ["version", "bench", "back", "notes"],
  "additionalProperties": false
}
