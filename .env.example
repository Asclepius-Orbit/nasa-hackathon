# Models the llm profile keeps cached in the ollama-models volume (space-separated Ollama tags).
# `docker compose -f app/docker-compose.yml --profile llm up -d` pulls only the missing ones.
SPINE_AGENT_LLM_MODELS="qwen3.5:4b qwen3.5:9b gemma4:e4b"

# OpenAI-compatible endpoint of the local Ollama used by the spine agent.
SPINE_AGENT_OLLAMA_BASE_URL=http://localhost:11434/v1

# Model the agent uses by default (must be one of the cached models).
SPINE_AGENT_MODEL=qwen3.5:4b

# ── MQTT broker (app/docker-compose.yml) ──────────────────────────────────────
# Never fill these by hand: `sh app/mosquitto/setup.sh` writes them to app/.env with random values
# (--force rotates them, --device [AST-NN:]<device_id> registers a real device). No value belongs in the repo.
SPINE_MQTT_APP_PASSWORD=
SPINE_MQTT_HEALTH_PASSWORD=
SPINE_MQTT_SIM_DEVICES=
SPINE_MQTT_SIM_PASSWORD=
SPINE_MQTT_ITEST_PASSWORD=
SPINE_MQTT_ITEST_DEVICE_PASSWORD=
SPINE_MQTT_DEVICES=
# One per entry of SPINE_MQTT_DEVICES, e.g. SPINE_MQTT_DEVICE_PASSWORD_WB_01 for wb-01.

# Optional LAN listener (TLS 8883, app/docker-compose.lan.yml): folder with ca.crt, server.crt and server.key
# (outside the repo) and the host address to publish it on.
SPINE_MQTT_TLS_DIR=
SPINE_MQTT_LAN_ADDRESS=

# Clients outside compose (compose sets them itself). Backend: SPINE_APP_*; simulator/gateway: SPINE_SIM_*
# (`{device_id}` in the username becomes each device's id); mosquitto tests: SPINE_TEST_*.
# SPINE_APP_MQTT_USERNAME=
# SPINE_APP_MQTT_PASSWORD=
# SPINE_APP_MQTT_TLS=
# SPINE_APP_MQTT_TLS_CA_FILE=
# SPINE_SIM_MQTT_USERNAME=
# SPINE_SIM_MQTT_PASSWORD=
# SPINE_SIM_MQTT_TLS=
# SPINE_SIM_MQTT_TLS_CA_FILE=
# SPINE_TEST_MQTT_USERNAME=
# SPINE_TEST_MQTT_PASSWORD=
# SPINE_TEST_MQTT_DEVICE_PASSWORD=
# Real wearable gateway (spine_monitor/gateway): Arduino over USB serial -> MQTT v1. All optional; defaults shown.
# Serial port as pyserial reads it: COM3, /dev/ttyACM0 or socket://host:port.
# SPINE_GATEWAY_SERIAL_URL=COM3
# SPINE_GATEWAY_SERIAL_BAUD=250000
# SPINE_GATEWAY_SERIAL_RECONNECT_INITIAL_S=1.0
# SPINE_GATEWAY_SERIAL_RECONNECT_FACTOR=2.0
# SPINE_GATEWAY_SERIAL_RECONNECT_MAX_S=10.0
# SPINE_GATEWAY_ASTRONAUT_ID=AST-01
# SPINE_GATEWAY_DEVICE_ID=wb-01
# SPINE_GATEWAY_MQTT_HOST=127.0.0.1
# SPINE_GATEWAY_MQTT_PORT=1883
# SPINE_GATEWAY_MQTT_CLIENT_ID=spine-gateway
# SPINE_GATEWAY_MQTT_USERNAME=wb-01
# SPINE_GATEWAY_MQTT_PASSWORD=
# SPINE_GATEWAY_MQTT_TLS=false
# SPINE_GATEWAY_MQTT_TLS_CA_FILE=
# SPINE_GATEWAY_MQTT_RECONNECT_INITIAL_S=1.0
# SPINE_GATEWAY_MQTT_RECONNECT_FACTOR=2.0
# SPINE_GATEWAY_MQTT_RECONNECT_MAX_S=30.0
# SPINE_GATEWAY_STATUS_INTERVAL_S=30.0
# SPINE_GATEWAY_CLOCK_SYNC_INTERVAL_S=60.0
# SPINE_GATEWAY_CLOCK_UNCERTAINTY_MS=20.0
# SPINE_GATEWAY_STALL_TIMEOUT_S=2.0
# SPINE_GATEWAY_CALIBRATION_DEFAULT_DURATION_S=5.0
# SPINE_GATEWAY_EMG_STREAM_ID=emg_lat_left
# SPINE_GATEWAY_IMU_STREAM_ID=imu_l3
# SPINE_GATEWAY_STRETCH_STREAM_ID=stretch_lumbar
# SPINE_GATEWAY_EMG_MUSCLE=latissimus_dorsi
# SPINE_GATEWAY_EMG_SIDE=left
# SPINE_GATEWAY_ADC_BITS=10
# SPINE_GATEWAY_VREF_V=5.0
# SPINE_GATEWAY_EMG_INPUT_PIN=A0
# SPINE_GATEWAY_STRETCH_INPUT_PIN=A1
# SPINE_GATEWAY_STRETCH_SERIES_RESISTOR_OHM=10000.0
# SPINE_GATEWAY_IMU_ACCEL_RANGE_G=4
# SPINE_GATEWAY_IMU_GYRO_RANGE_DPS=500
# SPINE_GATEWAY_IMU_DLPF_HZ=44
# SPINE_GATEWAY_EMG_GAIN=1.0
# EMG signal type from the analog module: raw, rectified or envelope. `envelope` is what the current module (Muscle
# Sensor V3 clone) is expected to give; still to be confirmed with the board (issue #13). `raw` assumes the signal is
# biased at Vref/2 (unverified) and is needed for spectral features.
# SPINE_GATEWAY_EMG_SIGNAL_KIND=envelope
# SPINE_GATEWAY_STRETCH_REST_LENGTH_MM=100.0
# SPINE_GATEWAY_EMG_MVC_WINDOW_MS=250
