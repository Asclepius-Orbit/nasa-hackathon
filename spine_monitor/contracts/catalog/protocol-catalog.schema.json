{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.asclepius-orbit.example/v1/catalog/protocol-catalog.schema.json",
  "title": "ProtocolCatalog",
  "description": "Fixed facts of every standardised protocol that the UI views quote (band, repetitions, rest, fit items). Only codes and numbers: the UI writes the words. A fact that does not apply to a protocol (a passive spine check has no band nor reps) is null, never a default.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "required": ["catalog_version", "entries"],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "protocol_id": {
          "description": "Same pattern as common.schema.json#/$defs/protocol_id.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]{1,63}$"
        },
        "band": {
          "description": "Elastic band the protocol uses; null when it uses none.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "color": { "type": "string", "pattern": "^[a-z][a-z_]{0,31}$" },
                "nominal_kg": { "type": "number", "minimum": 0 }
              },
              "required": ["color", "nominal_kg"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "total_reps": {
          "description": "Repetitions of one session; null for protocols without repetitions.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "rest_seconds": {
          "description": "Rest before finishing the session; null when the protocol has no rest.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "fit_items": {
          "description": "What the astronaut fits before starting, in order. Only ids: the UI writes the instructions.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
            },
            "required": ["id"],
            "additionalProperties": false
          }
        }
      },
      "required": ["protocol_id", "band", "total_reps", "rest_seconds", "fit_items"],
      "additionalProperties": false
    }
  }
}
