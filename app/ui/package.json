{
  "name": "spine-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "pnpm install --frozen-lockfile && node scripts/ensure-electron.mjs && electron-vite dev",
    "postinstall": "node scripts/ensure-electron.mjs",
    "gen:types": "node scripts/generate-contract-types.mjs",
    "check:types": "node scripts/generate-contract-types.mjs --check && tsc --noEmit -p tsconfig.contracts.json",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:e2e": "electron-vite build --mode e2e",
    "preview": "electron-vite preview",
    "dist": "pnpm build && electron-builder --win",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "pnpm build:e2e && playwright test --project=app",
    "audit": "pnpm audit --audit-level high",
    "check": "pnpm lint && pnpm typecheck && pnpm check:types && pnpm test:cov && pnpm run audit && pnpm check:bundle",
    "e2e:packaged": "pnpm build && electron-builder --win --dir && playwright test --project=packaged",
    "check:bundle": "pnpm build && node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
