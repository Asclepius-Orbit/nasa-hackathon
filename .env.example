# Models the llm profile keeps cached in the ollama-models volume (space-separated Ollama tags).
# `docker compose -f app/docker-compose.yml --profile llm up -d` pulls only the missing ones.
SPINE_AGENT_LLM_MODELS="qwen3.5:4b qwen3.5:9b gemma4:e4b"

# OpenAI-compatible endpoint of the local Ollama used by the spine agent.
SPINE_AGENT_OLLAMA_BASE_URL=http://localhost:11434/v1

# Model the agent uses by default (must be one of the cached models).
SPINE_AGENT_MODEL=qwen3.5:4b
