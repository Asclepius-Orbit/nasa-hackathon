# Variables of the app stack (no real values). setup.sh writes the MQTT passwords and tokens into app/.env.
# Single telemetry producer: simulator (default, profile sim) | device (profile hardware; Linux USB gateway).
SPINE_APP_TELEMETRY_SOURCE=simulator
# With device and no board (e.g. Windows): 1 starts the serial emulator + gateway-demo instead of hardware.
SPINE_GATEWAY_DEMO=0
