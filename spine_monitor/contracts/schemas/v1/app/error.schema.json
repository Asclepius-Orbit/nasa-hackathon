{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.asclepius-orbit.example/v1/app/error.schema.json",
  "title": "AppErrorResponse",
  "description": "Error body of every endpoint of the read-only API of the app, shaped after RFC 9457 problem details (served as application/problem+json). Same shape as the engine error, with the problems a read API can have.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "invalid_request",
        "invalid_range",
        "not_found",
        "unsupported_schema_version",
        "internal"
      ]
    },
    "title": { "type": "string" },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "detail": { "type": "string" },
    "errors": {
      "description": "Field-level problems, as JSON Pointer (or query parameter name) + message.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pointer": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["pointer", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "title", "status"],
  "additionalProperties": false
}
